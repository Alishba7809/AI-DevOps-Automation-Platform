# =====================================================================
# AI-Powered DevOps MCP Platform — Environment Variables
# =====================================================================
# Copy this file to `.env` and adjust values for your environment.

# ------ Backend ------
APP_NAME="DevOps MCP Platform"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# JWT secret — change this to a long random string for production
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENABLE_AUTH=false

# Database
DATABASE_URL=postgresql+psycopg2://devops:devops_pass@db:5432/devops_mcp

# Docker
DOCKER_SOCKET=unix:///var/run/docker.sock
CONTAINER_PREFIX=mcp-managed-

# Safety
ENABLE_DRY_RUN_DEFAULT=false
REQUIRE_CONFIRM_DESTRUCTIVE=true
MAX_EXECUTIONS_PER_MINUTE=30
MAX_FILE_SIZE_MB=50

# ------ Frontend ------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
